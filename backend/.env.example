# Copy to .env and fill in. NEVER commit a filled .env.
# Local dev against PostgreSQL (Supabase connection string goes here for live).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/apnadairy

# Long random string. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Admin seed account (used ONLY by `python -m app.seed`). No defaults in code.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Super Admin seed account. This role cannot be created through public registration.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Optional technical support contact shown in the Super Admin portal.
SUPPORT_NAME=ApnaDairy Technical Support
SUPPORT_EMAIL=
SUPPORT_PHONE=

# Groq server-side key for the chatbot. If empty, /chatbot/messages returns an
# honest "not configured" reply. NEVER expose this to the frontend.
GROQ_API_KEY=

# Demo helpers for local development (set false in production).
DEMO_MODE=true

# Periodic local-demo telemetry + freshness scoring. All generated records are
# explicitly returned as simulated/demonstration data. Disable outside demos.
IOT_AI_AUTOMATION_ENABLED=true
IOT_AI_AUTOMATION_INTERVAL_SECONDS=300
IOT_AI_READING_INTERVAL_SECONDS=300
IOT_AI_PREDICTION_INTERVAL_SECONDS=900
IOT_AI_MAX_BATCHES_PER_CYCLE=25

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
